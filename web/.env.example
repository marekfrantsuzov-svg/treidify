# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/treidify   # Neon, Supabase, RDS or any Postgres 14+
BETTER_AUTH_SECRET=                                         # openssl rand -base64 32
BETTER_AUTH_URL=https://app.treidify.com                    # where sign-in lives
NEXT_PUBLIC_SITE_URL=https://treidify.com                   # public website
NEXT_PUBLIC_APP_URL=https://app.treidify.com                # private platform; leave empty to serve both from one host
AUTH_COOKIE_DOMAIN=treidify.com                             # shares the session across both hosts; empty on a single host
DATA_ENCRYPTION_KEY=                                        # 32-byte base64 key for connection secrets: openssl rand -base64 32

# ── Email (verification, password reset, contact form) ────
RESEND_API_KEY=
EMAIL_FROM="Treidify <noreply@treidify.com>"
CONTACT_TO=support@treidify.com

# ── Sign in with Google / Apple (optional until configured) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=            # Services ID
APPLE_CLIENT_SECRET=        # JWT generated from your Sign in with Apple key
APPLE_APP_BUNDLE_ID=

# ── Providers (later stages) ──────────────────────────────
METAAPI_TOKEN=
MARKET_DATA_PROVIDER=       # e.g. twelvedata
MARKET_DATA_API_KEY=
NEWS_PROVIDER=
NEWS_API_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ── Public config ─────────────────────────────────────────
NEXT_PUBLIC_PRICE_MONTHLY=                  # set once prices are approved
NEXT_PUBLIC_PRICE_ANNUAL=
NEXT_PUBLIC_PRICES_FINAL=false              # true only after approval; until then the site says "Price announced at launch"
NEXT_PUBLIC_ANALYTICS_DOMAIN=

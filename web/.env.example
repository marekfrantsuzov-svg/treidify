# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/treidify   # Neon, Supabase, RDS or any Postgres 14+
BETTER_AUTH_SECRET=                                         # openssl rand -base64 32
BETTER_AUTH_URL=https://treidify.com
NEXT_PUBLIC_SITE_URL=https://treidify.com
DATA_ENCRYPTION_KEY=                                        # 32-byte base64 key for connection secrets: openssl rand -base64 32

# ── Email (verification, password reset, contact form) ────
RESEND_API_KEY=
EMAIL_FROM="Treidify <noreply@treidify.com>"
CONTACT_TO=support@treidify.com

# ── Sign in with Google / Apple (optional until configured) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=            # Services ID
APPLE_CLIENT_SECRET=        # JWT generated from your Sign in with Apple key
APPLE_APP_BUNDLE_ID=

# ── Providers (later stages) ──────────────────────────────
METAAPI_TOKEN=
MARKET_DATA_PROVIDER=       # e.g. twelvedata
MARKET_DATA_API_KEY=
NEWS_PROVIDER=
NEWS_API_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ── Public config ─────────────────────────────────────────
NEXT_PUBLIC_PRICE_MONTHLY=29
NEXT_PUBLIC_PRICE_ANNUAL=290
NEXT_PUBLIC_PRICES_FINAL=false
NEXT_PUBLIC_ANALYTICS_DOMAIN=
